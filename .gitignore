.roboflow_key
.env
*.key

# --- model weights (>100MB, GitHub rejects them) ---
weights/
*.pt

# --- virtualenv / caches ---
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.cache/
node_modules/

